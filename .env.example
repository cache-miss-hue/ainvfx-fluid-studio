# AInVFX Fluid Studio · 中文转英文翻译接口
# 推荐在界面顶栏「翻译设置」里填写（点保存会自动写入 .env，立即生效）；也可以直接编辑本文件。
# 把本文件复制为 .env（软件首次启动时会自动复制），填好后保存即可，不用重启软件。
# 只在你点「转英文」（或生成前自动转英文）时才会访问这个接口；视频生成本身始终离线、只用本机显卡。
# 不配置也能用：提示词直接写英文，或只用内置术语表替换特效词汇。
#
# 兼容三种接口格式（FX_TRANSLATE_WIRE）：
#   chat       OpenAI Chat Completions   POST {BASE_URL}/v1/chat/completions   ← DeepSeek、通义、Kimi、OpenAI、大多数中转站
#   responses  OpenAI Responses          POST {BASE_URL}/v1/responses
#   anthropic  Anthropic Messages        POST {BASE_URL}/v1/messages           ← Claude
#   auto       自动依次尝试（默认），成功后记住
# BASE_URL 写到 /v1 或不带 /v1 都可以。
#
# 示例（三选一，把对应几行去掉 # 号）：
#   DeepSeek 官方：
#     FX_TRANSLATE_BASE_URL=https://api.deepseek.com
#     FX_TRANSLATE_MODEL=deepseek-chat        （模型名以 DeepSeek 控制台/文档为准；和统一中转绘图框架里填的一样即可）
#   OpenAI 兼容中转站：
#     FX_TRANSLATE_BASE_URL=https://你的中转站地址/v1
#     FX_TRANSLATE_MODEL=中转站上的模型名
#   本机的 Ollama / LM Studio 等（不需要密钥）：
#     FX_TRANSLATE_BASE_URL=http://127.0.0.1:11434/v1
#     FX_TRANSLATE_MODEL=qwen2.5:7b

FX_TRANSLATE_BASE_URL=
FX_TRANSLATE_API_KEY=
FX_TRANSLATE_MODEL=

# 接口格式：auto / chat / responses / anthropic
FX_TRANSLATE_WIRE=auto
# 深度推理：off（默认，关闭思考，更快更省）/ auto（按模型默认）
FX_TRANSLATE_THINKING=off
# 超时秒数、随机性、最大输出长度
FX_TRANSLATE_TIMEOUT=60
FX_TRANSLATE_TEMPERATURE=0.2
FX_TRANSLATE_MAX_TOKENS=1000
# 代理：留空 = 跟随系统代理环境变量；none = 强制直连；或填 http://127.0.0.1:7890 这样的地址
FX_TRANSLATE_PROXY=
