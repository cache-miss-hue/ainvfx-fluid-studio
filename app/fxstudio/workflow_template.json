{
 "_说明": "扁平化 API 工作流模板。来源：原工作流 ainvfx-fluid_多关键帧特效版 实际运行时引擎展开的 prompt（嵌在 fx_00011_.mp4 元数据里），去掉了：在线 Gemma API 分支、提示词扩写分支、恒为假的开关、UI 拼图节点；画板/底图/控制视频组装改由 FXLoadControlFrames 读取应用层写好的文件。以 $名字 表示的值由 workflow.py 填充。",
 "unet":    {"class_type": "UNETLoader", "inputs": {"unet_name": "$UNET", "weight_dtype": "default"}},
 "lora":    {"class_type": "LTXICLoRALoaderModelOnly", "inputs": {"lora_name": "$LORA", "strength_model": "$LORA_STRENGTH", "model": ["unet", 0]}},
 "vae":     {"class_type": "VAELoader", "inputs": {"vae_name": "$VIDEO_VAE"}},
 "avae":    {"class_type": "VAELoader", "inputs": {"vae_name": "$AUDIO_VAE"}},
 "te":      {"class_type": "CLIPLoaderGGUF", "inputs": {"clip_name": "$TEXT_ENCODER", "type": "ltxv"}},
 "ctrl":    {"class_type": "FXLoadControlFrames", "inputs": {"job_dir": "$JOB_DIR"}},
 "silence": {"class_type": "EmptyAudio", "inputs": {"duration": 5.0, "sample_rate": 44100, "channels": 2}},
 "ctrlvid": {"class_type": "CreateVideo", "inputs": {"fps": 25.0, "bit_depth": "auto", "color_space": "sRGB", "codec": "none", "images": ["ctrl", 0], "audio": ["silence", 0]}},
 "comp":    {"class_type": "GetVideoComponents", "inputs": {"video": ["ctrlvid", 0]}},
 "size":    {"class_type": "GetImageSize", "inputs": {"image": ["comp", 0]}},
 "pos":     {"class_type": "CLIPTextEncode", "inputs": {"text": "$PROMPT", "clip": ["te", 0]}},
 "neg0":    {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["pos", 0]}},
 "cond1":   {"class_type": "LTXVConditioning", "inputs": {"positive": ["pos", 0], "negative": ["neg0", 0], "frame_rate": ["comp", 2]}},
 "cond2":   {"class_type": "LTXVConditioning", "inputs": {"positive": ["cond1", 0], "negative": ["cond1", 1], "frame_rate": ["comp", 2]}},
 "empty":   {"class_type": "EmptyLTXVLatentVideo", "inputs": {"batch_size": 1, "width": ["size", 0], "height": ["size", 1], "length": ["size", 2]}},
 "i2v":     {"class_type": "LTXVImgToVideoInplace", "inputs": {"strength": 0.7, "vae": ["vae", 0], "image": ["comp", 0], "latent": ["empty", 0], "bypass": true}},
 "guide":   {"class_type": "LTXAddVideoICLoRAGuide", "inputs": {"frame_idx": 0, "strength": 1.0, "crop": "disabled", "use_tiled_encode": false, "tile_size": 256, "tile_overlap": 64, "use_streaming": false, "tile_frames": 97,
             "positive": ["cond2", 0], "negative": ["cond2", 1], "vae": ["vae", 0], "latent": ["i2v", 0], "image": ["comp", 0], "latent_downscale_factor": ["lora", 1]}},
 "tailg":   {"class_type": "LTXVAddGuide", "inputs": {"frame_idx": "$TAIL_IDX", "strength": "$TAIL_STRENGTH", "positive": ["guide", 0], "negative": ["guide", 1], "vae": ["vae", 0], "latent": ["guide", 2], "image": ["ctrl", 4]}},
 "aenc":    {"class_type": "VAEEncodeAudio", "inputs": {"audio": ["comp", 1], "vae": ["avae", 0]}},
 "aref":    {"class_type": "LTXVSetAudioRefTokens", "inputs": {"positive": ["cond2", 0], "negative": ["cond2", 1], "audio_latent": ["aenc", 0]}},
 "concat":  {"class_type": "LTXVConcatAVLatent", "inputs": {"video_latent": ["tailg", 2], "audio_latent": ["aref", 2]}},
 "noise":   {"class_type": "RandomNoise", "inputs": {"noise_seed": "$SEED"}},
 "guider":  {"class_type": "CFGGuider", "inputs": {"cfg": 1.0, "model": ["lora", 0], "positive": ["tailg", 0], "negative": ["tailg", 1]}},
 "sampler": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler_ancestral"}},
 "sigmas":  {"class_type": "ManualSigmas", "inputs": {"sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"}},
 "sample":  {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["noise", 0], "guider": ["guider", 0], "sampler": ["sampler", 0], "sigmas": ["sigmas", 0], "latent_image": ["concat", 0]}},
 "sep":     {"class_type": "LTXVSeparateAVLatent", "inputs": {"av_latent": ["sample", 0]}},
 "crop":    {"class_type": "LTXVCropGuides", "inputs": {"positive": ["tailg", 0], "negative": ["tailg", 1], "latent": ["sep", 0]}},
 "adec":    {"class_type": "LTXVAudioVAEDecode", "inputs": {"samples": ["sep", 1], "audio_vae": ["avae", 0]}},
 "vdec":    {"class_type": "VAEDecodeTiled", "inputs": {"tile_size": "$TILE_SIZE", "overlap": 64, "temporal_size": 128, "temporal_overlap": 32, "samples": ["crop", 2], "vae": ["vae", 0]}},
 "out":     {"class_type": "CreateVideo", "inputs": {"bit_depth": 8, "color_space": "sRGB", "codec": "none", "images": ["vdec", 0], "fps": ["comp", 2], "audio": ["adec", 0]}},
 "save":    {"class_type": "SaveVideo", "inputs": {"filename_prefix": "$PREFIX", "format": "auto", "codec": "auto", "format.codec": "auto", "video": ["out", 0]}}
}
